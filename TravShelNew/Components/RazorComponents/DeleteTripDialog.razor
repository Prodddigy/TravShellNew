@using TravShell.App.Trips
@inject ISnackbar Snackbar

@inject NavigationManager navigationManager

<MudDialog>
    <TitleContent>
        Delete Trip
    </TitleContent>
    <DialogContent>
        Do you really want to delete @tripName trip?
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code {

        [Inject]
        public required ITripService tripsService { get; set; }

        [CascadingParameter]
        private MudDialogInstance MudDialog { get; set; }

        [Parameter]
        public int tripToDelete {get;set;}

        [Parameter]
        public string tripName { get; set; }  


        private async void Submit() 
        {
            await tripsService.RemoveTripById(tripToDelete);

           
        navigationManager.Refresh(true);
            MudDialog.Close(DialogResult.Ok(true));
        Snackbar.Add($"{tripName} has been deleted!", Severity.Success);
           
        }


    private void Cancel() => MudDialog.Cancel();
}

