@using System.Globalization
@using TravShell.App.GoogleAPI


<MudDialog Style="height:900px;">
    <DialogContent>
        Choose a place.
        <MudGrid>
             <MudItem xs="4">
        <MudPaper Outlined Class="border-dashed" Height="250px" Style="width:200px;">

                    <MudAutocomplete  @onclick="()=>AttsLoaded = true" T="string" Label="Search for places"
                                     Placeholder="Start typing..."
                                     SearchFunc="SearchPlacesAsync"
                                     Clearable="true"
                                     CoerceText="true"
                                     ResetValueOnEmptyText="true" @bind-Value="tmpPlace.City" />
                    <MudButton OnClick="GetAttractions" ButtonType="MudBlazor.ButtonType.Submit" Disabled="AttsLoaded" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">
                    @if (IsSearching)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <MudText >Search</MudText>
                    }
                    </MudButton>
            <MudText Align="Align.Center">Attractions</MudText>
            <div style="max-height:200px; overflow-y: auto; ">
                @foreach(var i in attractions)
                {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="flex-shrink: 0; padding: 10px 20px;" Class="ml-auto" OnClick="()=>SetAttraction(i)">
                        
                        <MudText  Align="Align.Left">
                                    @($"{i.Name}, rating: {i.Rating}")
                        </MudText>
                      
                    </MudButton>
                }
            </div>
        </MudPaper>
            </MudItem>

          <MudItem xs="12" sm="6">
                <MudPaper Class="pa-4 mud-height-full">
                    <GoogleMap @ref="googleMapRef"
                       ApiKey="@TravShell.App.GoogleAPI.GoogleService.apiKey"
                       Center="@center"
                       Height="300"
                       Width="100"
                       Zoom="12"
                       Markers="markers"
                       Clickable="true" />
        </MudPaper>
            </MudItem>
            @if(chosenAtt!=null)
            {
                <MudPaper Class="pa-4 mud-height-full" Outlined="true">
                    <MudText>@chosenAtt.Name<br />
                      <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Large" Color="Color.Success" /> Address: @chosenAtt.Vicinity<br />
                      <MudIcon Icon="@Icons.Material.Filled.StarRate" Size="Size.Large" Color="Color.Warning" /> Rating: @chosenAtt.Rating<br/>
                        <MudIcon Icon="@Icons.Material.Filled.Public" Size="Size.Large" Color="Color.Info" /> Website:<a href="@($"https://www.google.com/maps?q={chosenAtt.latitude.ToString(CultureInfo.InvariantCulture)},{chosenAtt.longitude.ToString(CultureInfo.InvariantCulture)}")" target='_blank'> See on Google Maps</a><br />
                    </MudText>
                </MudPaper>
            }
          
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Disabled="AttNotChosen" Color="Color.Primary" OnClick="ReturnChosenTrip">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [Inject]
    public required IGoogleService GoogleService { get; set; }

    public GoogleMapCenter center { get; set; }

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    [Parameter]
    public double longitude { get; set; }

    [Parameter]
    public double latitude { get; set; }
    GoogleMap googleMapRef = default!;

    private void Cancel() => MudDialog.Cancel();

    private AttractionViewModel chosenAtt = null;

    private TripViewModel tmpPlace = new();

    private List<AttractionViewModel> attractions = new();

    private bool IsSearching = false;

    private bool AttsLoaded = false;

    private bool AttNotChosen = true;

    public List<GoogleMapMarker> markers = new();
    private CancellationTokenSource? cts;


    protected override Task OnParametersSetAsync()
    {
        if (cts != null)
        {
            cts.Cancel();
        }
        cts = new CancellationTokenSource();

        center = new GoogleMapCenter(latitude, longitude);
        return base.OnParametersSetAsync();
    }

    public async void ReturnChosenTrip()
    {
        AttNotChosen = true;
        List<AttractionViewModel> tmpAttractionChosenList  = new();

        tmpAttractionChosenList.Add(chosenAtt);

        tmpAttractionChosenList = await GoogleService.GetSetAttractionsDetails(tmpAttractionChosenList,cts.Token);



        MudDialog.Close(DialogResult.Ok(tmpAttractionChosenList.FirstOrDefault()));
    }

    private async Task<IEnumerable<string>> SearchPlacesAsync(string place, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(place))
            return Enumerable.Empty<string>();
            
        var result =  await GoogleService.GetPlaceNamesAutocomplete(place, cancellationToken);

        return result;
    }

    private async Task GetAttractions()
    {
        if (tmpPlace.City == null || tmpPlace.City.Trim()=="")
        {
            return;
        }

        IsSearching = true;
        AttsLoaded = true;
        StateHasChanged();
        await Task.Delay(1);

        tmpPlace = await GoogleService.GetCoordinates(tmpPlace, cts.Token);

         attractions = await GoogleService.GetSetAttractions($"{tmpPlace.latitude.ToString(CultureInfo.InvariantCulture)}%2C{tmpPlace.longitude.ToString(CultureInfo.InvariantCulture)}",
        AttractionType.Attraction, attractions, cts.Token);
        //attractions
       // attractions = await GoogleService.GetSetAttractionsDetails(tmpNewAtts);

        IsSearching = false;
        AttsLoaded = false;

        StateHasChanged();
        await Task.Delay(1);

    }

    private async void SetAttraction(AttractionViewModel att)
    {
        chosenAtt = att;

        if(chosenAtt != null )
        {
            AttNotChosen = false;
            markers.Clear();
            markers.Add(new GoogleMapMarker()
                {
                    Position = new GoogleMapMarkerPosition(att.latitude, att.longitude),
                    Title = att.Name
                });

            center = new GoogleMapCenter(att.latitude, att.longitude);

            await googleMapRef.UpdateMarkersAsync(markers);
        }
        else
        {
            chosenAtt = null;
            AttNotChosen = true;
        }
        StateHasChanged();
    }

}
