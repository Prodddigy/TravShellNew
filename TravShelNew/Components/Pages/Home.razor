@using Microsoft.AspNetCore.Components.Authorization

@page "/"

@rendermode InteractiveServer

@inject AuthenticationStateProvider ASP
@inject NavigationManager navigationManager

@inject DataContext dataContext

<PageTitle>Home</PageTitle>

<div class="row">

	<MudText Style="@($"color:{Colors.Purple.Darken4};")" Typo="Typo.h1">Travelling in a nutshell</MudText>
	

	<MudContainer style=" margin: auto;  width: 60vw; min-width:400px; padding: 10px;">
		<MudGrid>
	
			<AuthorizeView>
				<NotAuthorized>
					<MudText Typo="Typo.h4">Welcome! Please login or create a new account.</MudText>
					<MudPaper Class=" align-start d-flex" Style="width: 250px;">
						<MudPaper Class="pa-3" Elevation="6">
							 <MudFab Href="/login" Color="Color.Primary" Label="Login" StartIcon="@Icons.Material.Filled.Login" />
							 </MudPaper>
						<MudSpacer />
						<MudPaper Class="pa-3" Elevation="6"> 
							<MudFab  Href="/register" Color="Color.Tertiary" Label="Register" StartIcon="@Icons.Material.Filled.AccountCircle" />
						</MudPaper>
					</MudPaper>
				</NotAuthorized>
				<Authorized>
					<MudDivider />
					<p>

					</p>
					<p>
					<MudText Typo="Typo.h5"> Hello! <b>@UserName</b>! Where would you like to travel today?</MudText>
					</p>
					<MudDivider />
					<MudButton Variant="Variant.Filled" Href="@($"/createTrip/{UserId}/newTrip")" Color="Color.Success">New Trip! <MudIcon Icon="@Icons.Material.Filled.TravelExplore" Size="Size.Large" Color="Color.Warning" /> </MudButton>
					
					<MudButton Variant="Variant.Filled" Href="@($"/trips/{UserId}")" Color="Color.Surface">Trip List <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Large" Color="Color.Info" /> </MudButton>
					
					<MudSpacer />
					<MudButton Href="@($"/createRandomTrip/{UserId}/newTrip")">Random Trip <MudIcon Icon="@Icons.Material.Filled.NotListedLocation" Color="Color.Secondary"Size="Size.Large"/></MudButton>
					<MudCarousel Class="mud-width-full" Style="height:200px;" ShowArrows="@arrows" ShowBullets="@bullets" EnableSwipeGesture="@enableSwipeGesture" AutoCycle="@autocycle" TData="object">
						<MudCarouselItem Transition="transition" Color="@Color.Primary">
							<div class="d-flex" style="height:100%">
								<h1>
									Old Trips
								</h1>
							</div>
						</MudCarouselItem>
						<MudCarouselItem Transition="transition" Color="@Color.Secondary">
							<div class="d-flex" style="height:100%">
								<h1>
									New Trips
								</h1>
							</div>
						</MudCarouselItem>
						<MudCarouselItem Transition="transition" Color="@Color.Error">
							<h1>
								All Trips
							</h1>
						</MudCarouselItem>
					</MudCarousel>
				
				</Authorized>
			</AuthorizeView>
	
	</MudGrid>

		@*<MudButton OnClick="CreateReviewTest"> Review</MudButton>*@
	</MudContainer>

</div>


@code{

	[Inject]
	public required IUserService UserService { get; set; }

	private bool arrows = true;
	private bool bullets = true;
	private bool enableSwipeGesture = true;
	private bool autocycle = true;
	private Transition transition = Transition.Slide;

	// [CascadingParameter]
	// private Task<AuthenticationState> authenticationStateTask { get; set; }

	// [CascadingParameter]
	// public HttpContext HttpContext { get; set; }


	public string UserName { get; set; } = "Error";


	public int UserId { get; set; }

	protected override async Task OnInitializedAsync()
	{

		var authState = await ASP.GetAuthenticationStateAsync();


		if (authState.User.Identity.IsAuthenticated)
		{

			User user = await UserService.FindUserByIdAsync(authState.User.Identity.Name);

			//User user = dataContext.Users.Where(x => x.Id == Int32.Parse(authState.User.Identity.Name)).FirstOrDefault();
			if (user != null)
			{
				UserName = user.Forename;
				UserId = user.UserId;
				Console.WriteLine("idiiidid: "+UserId);
			}
		}
	}

	private void EnterTrip(int TripId)
	{

		string a = $"/trips/{UserId}/{TripId}";

		navigationManager.NavigateTo(a);

	}

	private void navigateToCreateTrip()
	{


		string b = $"/createTrip/{UserId}/newTrip";

		navigationManager.NavigateTo(b);
	}




