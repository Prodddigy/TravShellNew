@page "/public-trips/{UserId:int}/{TripId:int}"

@rendermode InteractiveServer

@attribute [Authorize]

@inject DataContext dataContext
@inject AuthenticationStateProvider ASP
@inject NavigationManager navi

@inject ISnackbar Snackbar

@using TravShell.App.Attractions
@using TravShell.App.PublicTrips
@using TravShell.App.Reviews
@using TravShell.App.Tags
@using TravShell.App.Trips
@using TravShell.Core.Entities
@using Markdig

@if(IsAuth)
{
    @*<h3>User id: @UserId and Trip id: @TripId</h3>*@

    if(TripExists)
    {
        <MudText Style="@($"color:{Colors.Purple.Darken4};")" Typo="Typo.h3"> Trip name: @TripName</MudText>  
   
        <MudContainer style=" margin: auto;  width: 80vw; min-width:400px; padding: 10px;">
<MudGrid>
    <MudItem >
        <MudExpansionPanels  Style="width:200px;">
                       
        <MudExpansionPanel Text="Write a review" MaxHeight="1000" >
            <MudTextField OnKeyUp="enableSave"  T="string" @bind-Value="userReviewDesc"  Immediate="true" Counter="50" MaxLength="50" Label="Review" Variant="Variant.Outlined" Lines="5" FullWidth />
            <MudRating  @bind-SelectedValue="userRating" FullIcon="@Icons.Material.Filled.Favorite" EmptyIcon="@Icons.Material.Filled.FavoriteBorder" Color="Color.Secondary" />
            <MudToolBar Class="gap-4">

                <MudButton OnClick="SaveReview"  Disabled="@editMode"  Variant="Variant.Filled" Color="Color.Success">Save </MudButton>
            </MudToolBar>
                   
        </MudExpansionPanel>
    </MudExpansionPanels>

    </MudItem>
        <MudItem > 
<MudCarousel Class="mud-width-full" @ref="_carousel" ItemsSource="@_source" Style="height:250px; width:450px" ShowArrows="true" ShowBullets="false" EnableSwipeGesture="false" AutoCycle="false" @bind-SelectedIndex="staticIndex">
    <ItemTemplate>
                    <div class="horizontal-scroll" style="height:100%; padding: 33px;">
    <MudText Typo="Typo.h4" Style="@($"color:{Colors.Purple.Darken3};")">Day @(selectedIndex + 1) / @TripDays</MudText>
    
    <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Left" Reverse="false">

    @foreach (var attraction in @context)
        {
            <MudTimelineItem Color="Color.Transparent" Size="Size.Large">
                <ItemDot >
                    <MudText Style="@($"color:{Colors.Purple.Darken3};")" Typo="Typo.h4">@(context.IndexOf(attraction) + 1)</MudText>
                </ItemDot>
                <ItemContent>
                    @attraction.Name
                </ItemContent>
            </MudTimelineItem>
       
            <MudTimelineItem Color="Color.Info" Size="Size.Medium">
                <ItemContent>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info">Opening at:</MudChip> @attraction.Opening_Hours
                </ItemContent>
            </MudTimelineItem>

            <MudTimelineItem Color="Color.Success" Size="Size.Medium">
                <ItemContent>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Success">Address:</MudChip> @attraction.Vicinity
                </ItemContent>
            </MudTimelineItem>


            <MudTimelineItem Color="Color.Warning" Size="Size.Medium">
                <ItemContent>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Warning">Rating:</MudChip> @attraction.Rating
                </ItemContent>
            </MudTimelineItem>


            <MudTimelineItem Color="Color.Error" Size="Size.Medium">
                <ItemContent>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Error">Type:</MudChip> @attraction.Type
                </ItemContent>
            </MudTimelineItem>
        }
        </MudTimeline>
        </div>

    </ItemTemplate>
    
    <PreviousButtonTemplate>
        <div @onclick="GoLeft" Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon">
            <span class="mud-icon-button-label">
                <MudIcon  Class="mud-ripple mud-ripple-icon mud-icon-button-size-medium" Icon="@Icons.Material.Filled.SkipPrevious" Color="@Color.Inherit" />
            </span>
        </div>
    </PreviousButtonTemplate>
    <NextButtonTemplate>
        <div @onclick="GoRight" Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon">
            <span class="mud-icon-button-label">
                <MudIcon  Class="mud-ripple mud-ripple-icon mud-icon-button-size-medium" Icon="@Icons.Material.Filled.SkipNext" Color="@Color.Inherit" />
            </span>
        </div>
    </NextButtonTemplate>

</MudCarousel>
</MudItem>


<MudItem  >
        <MudPaper Outlined Class="border-dashed" Height="250px" Style="width:200px;" >
        <MudText Align="Align.Center">Tags</MudText>
        <div style="height:200px; display: flex; flex-direction:column; overflow-y: auto; white-space: nowrap; gap: 8px; padding: 8px;">
        @foreach(var t in Tags)
        {
    <MudButton Variant="Variant.Filled" Style="flex-shrink: 0; padding: 10px 20px;"><b>#@t.Name</b></MudButton>
        }
        </div>
    </MudPaper>


</MudItem>

</MudGrid>

<MudGrid>
    <MudItem>
        <MudPaper Outlined Class="border-dashed" Height="250px" Style="width:200px;">
            <MudText Align="Align.Center">Reviews</MudText>
            <div style="height:200px; display: flex; flex-direction:column; overflow-y: auto; white-space: nowrap; gap: 8px; padding: 8px;">
               @if(Reviews.Count() ==0)
               {
 <MudButton Variant="Variant.Filled" Style="flex-shrink: 0; padding: 10px 20px;"><b>No reviews</b></MudButton>
               }
                
                @foreach (var r in Reviews)
                {
                    
                    <MudPaper Outlined="true">
                        <MudChip T="string" Color="Color.Primary">@r.User.Forename</MudChip>
                        <MudText Style="white-space: normal;overflow-wrap: break-word; padding: 10px 15px;" Align="Align.Left">
                                        @((MarkupString)Markdig.Markdown.ToHtml(r.Content, pipeline))
                                    </MudText>
                 <MudRating ReadOnly="true" SelectedValue="r.StarReview" FullIcon="@Icons.Material.Filled.Favorite" EmptyIcon="@Icons.Material.Filled.FavoriteBorder" Color="Color.Secondary" />
                </MudPaper>
             

                }
                 <MudButton Color="Color.Tertiary" Variant="Variant.Filled" OnClick="async ()=>await GetFourTripReviews(reviewSkip)">More</MudButton>
            </div>
            
        </MudPaper>

    </MudItem>
    <MudItem xs="7" >
     
<GoogleMap @ref="googleMapRef"
           ApiKey="@TravShell.App.GoogleAPI.GoogleService.apiKey"
           Center="@center"
           Height="280"
           Width="100"
           Zoom="12"
           Markers="markers" 
        Clickable="true"/>
    </MudItem>

           <MudItem xs="5" >
            
                  <MudPaper >
                      <MudText Typo="Typo.h4" GutterBottom>Description</MudText>
                        @if ((tripDescriptionMarkUp.Value.ToString()).Trim() == "")
                     {
                            <MudText Label="Description" a Style="max-height: 10em; overflow-y: auto;">
                                No description. :(

                            </MudText>
                     }
                     else
                     {
	                <MudText Label="Description" Style="max-height: 10em; overflow-y: auto;">
                            @(tripDescriptionMarkUp)

                    </MudText>
                     }
                    </MudPaper>

           </MudItem>

     
            </MudGrid>
            
        </MudContainer>
    }
    else
    {
        <h1>Trip @TripId does not exist, or is not public.</h1>
    }
}
else
{
    <h1>Not Authorized</h1>
}

@code {

    [Inject]
    public required IAttractionService attractionsService { get; set; }

    [Inject]
    public required ITripService tripsService { get; set; }

    [Inject]
    public required ITagService tagsService { get; set; }

    [Inject]
    public required IReviewService reviewsService { get; set; }

    [Parameter]
    public int UserId { get; set; }
    [Parameter]
    public int TripId { get; set; }

    public List<Attraction> Attractions { get; set; } = default;

    public Dictionary<DateTime, List<Attraction>> AttractionMap { get; set; } = new();

    public int TripDays { get; set; }

    GoogleMap googleMapRef = default!;

    public GoogleMapCenter center /*= new GoogleMapCenter(37.50024109655184, -122.28528451834352)*/;
    public List<GoogleMapMarker> markers = new();

    public List<List<GoogleMapMarker>> AllMarkers = new();

    public Trip currentTrip { get; set; }
    public string TripName { get; set; } = "Loading...";

    private MudCarousel<List<Attraction>> _carousel;
    private IList<List<Attraction>> _source = new List<List<Attraction>>();

    private int staticIndex = 0;

    private int selectedIndex = 0;

    private bool IsAuth = false;

    private bool TripExists = true;

    private bool editMode = true;

    private string tripDescription = "";

    private MarkupString? tripDescriptionMarkUp = (MarkupString)"";

    MarkdownPipeline pipeline = default;

    private bool isPublic = false;

    private string tagName="";

    private List<Tag> Tags = new List<Tag>(); 

    private List<Review> Reviews = new List<Review>();

    private Review currentUserReview = null;

    private int reviewSkip = 0;

    private string userReviewDesc = "";

    private int userRating = 0;


    protected async override Task OnInitializedAsync()//zmniejszyć to!!!
    {
        var authState = await ASP.GetAuthenticationStateAsync();

        if (authState.User.Identity.IsAuthenticated)
        {

            IsAuth = true;
            currentTrip = await tripsService.FindPublicTripById(TripId);

            pipeline = new MarkdownPipelineBuilder()
             .UseAdvancedExtensions() 
             .DisableHtml()
                .UseEmojiAndSmiley()
               .Build();

            if (currentTrip == null)
            {
                TripExists = false;
                return;
            }

            if(currentTrip.Description !=null)
            {
                tripDescription = currentTrip.Description;
                isPublic = currentTrip.IsPublic;
                tripDescriptionMarkUp =(MarkupString) Markdig.Markdown.ToHtml(tripDescription, pipeline);
                StateHasChanged();
            }

            TripName = currentTrip.Name;
            int numOfAtt = await attractionsService.CountTripAttractions(TripId);
            if (numOfAtt != 0)
            {
                Attractions = await attractionsService.GetTripAttractionsOrderByStartDate(TripId);

                DateTime tmp = Attractions.First().StartDate;

                List<Attraction> tmpList = new();
                foreach(var a in Attractions)
                {
                    if (a.StartDate == tmp )
                    {
                        tmpList.Add(a);
                    }
                    else
                    {
                        AttractionMap.Add(tmp, tmpList);

                        tmp=a.StartDate;

                        tmpList = new();

                        tmpList.Add(a);

                        if(Attractions.Last()==a)
                        {
                            AttractionMap.Add(tmp, tmpList);
                            break;
                        }
                    }
                    if (Attractions.Last() == a)
                    {
                        AttractionMap.Add(tmp, tmpList);
                    }
                }

                foreach (var a in AttractionMap)
                {
                    _source.Add(a.Value.OrderBy(x=>x.step).ToList());
                }

                int i = 1;
                foreach(var a in AttractionMap)
                {
                    i = 1;

                    var newMarkers = new List<GoogleMapMarker>();

                    foreach(var aa in a.Value.OrderBy(x=>x.step).ToList())
                    {
                        newMarkers.Add(new GoogleMapMarker()
                        {
                            Position = new GoogleMapMarkerPosition(aa.latitude, aa.longitude),

                            PinElement = new PinElement
                            {
                                Glyph = (i++) + "",
                                GlyphColor = "white",
                                Background = "Purple",
                                BorderColor="Black"

                            },

                            Title = aa.Website != "Website is not available." ? $" <a target = '_blank' jstcache = '6' href = '{aa.Website}' tabindex = '0'> <span> Check the website!</span> </a> " : "<h1> No Website available </h1>",
                        });
                    }
                    AllMarkers.Add(newMarkers);

                }
                markers = AllMarkers[0];
            }

            var trip = await tripsService.FindTripById(TripId);

            if(trip != null)
            {
                TripDays = trip.Days;
                center = new GoogleMapCenter(trip.latitude, trip.longitude);
            }
            await GetAllTripTags();


            await GetCurrentUserReview();

            await GetFourTripReviews(reviewSkip);


            StateHasChanged();
            await Task.Delay(3);
            await googleMapRef.RefreshAsync();

        }
    }

    // private bool editDescription()
    // {
    //     editMode=false;
    //     StateHasChanged();

    //     return editMode;
    // }

    // private async void SaveDescription()
    // {
    //     await tripsService.EditTripDescription(tripDescription.ToString(), TripId);
    //     editMode = true;

    //     UpdateHTMLAsync();
    //     StateHasChanged();

    //     Snackbar.Add($"Description has been saved!", Severity.Success);
    // }

    private async void RefreshMap()
    {
        await googleMapRef.RefreshAsync();
        await googleMapRef.UpdateMarkersAsync(markers);
    }

    private async Task GoLeft()
    {
        selectedIndex--;
        if(selectedIndex<0)
        {
            markers = AllMarkers.Last();
            selectedIndex = TripDays - 1;
        }
        else
        {
            markers = AllMarkers[selectedIndex];
        }

        await googleMapRef.UpdateMarkersAsync(markers);
        await InvokeAsync(StateHasChanged);
    }

    private async Task GoRight()
    {
        selectedIndex++;
        if (selectedIndex >= TripDays)
        {
            selectedIndex = 0;

            markers = AllMarkers.First();
        }
        else
        {
            markers = AllMarkers[selectedIndex];
        }
        await googleMapRef.UpdateMarkersAsync(markers);
        await InvokeAsync(StateHasChanged);
    }


    protected void UpdateHTMLAsync()
    {
        if (currentTrip.Description != null)
        {
            tripDescriptionMarkUp = (MarkupString)Markdig.Markdown.ToHtml(currentTrip.Description, pipeline);
        }
    }

    private async Task  GetAllTripTags()
    {
        var tags =  await tagsService.GetTripTags(TripId);
        if(tags != null)
        {
            Tags = tags;
            StateHasChanged();
        }
    }

    private async Task GetFourTripReviews(int skip)
    {
        var revs = await reviewsService.GetFourTripReviews(TripId,skip);

        if(revs != null && revs.Count() !=0)
        {
            Reviews.AddRange(revs);
            StateHasChanged();
            reviewSkip += 4;
        }
    }

    private async void SaveReview()
    {
        if(userReviewDesc.Trim() == "" ||userRating==0)
        {
            Snackbar.Add($"Review is not complete", Severity.Warning);
            return;
        }

        editMode = true;

        StateHasChanged();
        var newReview = await reviewsService.CreateReview(UserId, TripId, userReviewDesc, userRating);
        if(newReview != null)
        {
            Reviews.RemoveAll(x => x.User.UserId == newReview.User.UserId);
            Reviews.Add(newReview);
            StateHasChanged();
            Snackbar.Add($"New review has been saved!", Severity.Success);
        }
        else
        {
            Snackbar.Add($"Review not saved, something went wrong...", Severity.Error);
        }
    }

    private async Task GetCurrentUserReview()
    {
        currentUserReview = await reviewsService.GetUserReview(UserId, TripId);

        if(currentUserReview != null)
        {
            userReviewDesc = currentUserReview.Content;

            userRating = currentUserReview.StarReview;
            StateHasChanged();
        }
    }


    private void enableSave()
    {
        editMode = false;
        StateHasChanged();
    }

}
<style>
    .horizontal-scroll {
        white-space: nowrap;
        overflow-x: auto; 
        width: 100%; 
        border: 1px solid #ccc; 
        padding: 10px; 
        position: relative;
        height:80vh; 
    }
    .horizontal-scroll span {
        display: inline-block;
        top:0px;
    }
</style>
