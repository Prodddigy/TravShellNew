@page "/login"
@using TravShelNew.Components.Middleware

@using System.Security.Claims;

@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Authentication

@rendermode InteractiveServer

@inject DataContext dataContext
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider ASP
@if (AlreadyLoggedIn)
{

	<h1>You are already logged in</h1>
}
else
{
		
		<EditForm Model="@Model" OnValidSubmit="Authenticate" FormName="LoginForm" style=" margin: auto;  width: 50%; padding: 10px;">
	<DataAnnotationsValidator />
		<div class="mb-3 text-center flex-column">
			<h3>LOGIN</h3>
		</div>
		<MudGrid>
			<MudItem xs="12" >
				<MudCard>
					<MudCardContent>
						<MudTextField Label="Email" @bind-Value="Model.Email" For="@(()=>Model.Email)"/>
						<MudTextField Label="Password" InputType="InputType.Password" Class="mt-3" @bind-Value="Model.Password" For="@(()=>Model.Password)" />
					</MudCardContent>
					<MudCardActions>
						<MudButton ButtonType="MudBlazor.ButtonType.Submit" Disabled="IsLogging" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">
						@if(IsLogging)
							{
								<MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
							}
							else
							{
								<MudText>Login </MudText>
							}

							
							
						</MudButton>
					</MudCardActions>
				</MudCard>
			</MudItem>
				<MudItem xs="12">
					<MudText Typo="Typo.body2" Align="Align.Center">
						<MudText Color="Color.Error">@errorMessage</MudText>
					</MudText>
				</MudItem>

		</MudGrid>
	</EditForm>
}

@code {

	[Inject]
	public required IUserService UserService { get; set; }

	[SupplyParameterFromForm]
	public LoginViewModel Model { get; set; } = new();

	private string? errorMessage;

	private bool IsLogging = false;

	private bool AlreadyLoggedIn = false;

	protected async override  Task OnInitializedAsync()
	{
		var authState = await ASP.GetAuthenticationStateAsync();

		if (authState.User.Identity.IsAuthenticated)
		{
			AlreadyLoggedIn = true;	
		}
	}

	private async Task Authenticate()
	{
		IsLogging = true;
		StateHasChanged();
		await Task.Delay(1);

		var user1 = await UserService.FindUserAsync(Model.Email);

		if (user1 is null)
		{
			errorMessage = "Invalid Email or Password";
			IsLogging = false;
			return;
		}

		if (!BCrypt.Verify(Model.Password, user1.PasswordHash))
		{
			errorMessage = "Invalid Email or Password";
			IsLogging = false;
			return;
		}

		var claims = new List<Claim>
		{
			new Claim(ClaimTypes.Email, Model.Email),
			new Claim(ClaimTypes.Name,user1.UserId+""),
			new Claim(ClaimTypes.Role, "user")
		};

		var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
		var principal = new ClaimsPrincipal(identity);

		Guid key = Guid.NewGuid();
		 TravShellAuthMiddleware.Logins[key] = principal;

		string path3 = $"/login?key={key}";

		navigationManager.NavigateTo(path3, true);
		
	}
}
