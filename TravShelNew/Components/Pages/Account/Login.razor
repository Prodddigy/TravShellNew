
@using TravShelNew.Components.Middleware

@using System.Security.Claims;

@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Authentication



@page "/login"

@rendermode InteractiveServer

@inject DataContext dataContext
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider ASP
@if (AlreadyLoggedIn)
{

	<h1>You are already logged in</h1>
}
else
{
		

		<EditForm Model="@Model" OnValidSubmit="Authenticate" FormName="LoginForm" style=" margin: auto;  width: 50%;
  padding: 10px;">
	<DataAnnotationsValidator />
		<div class="mb-3 text-center flex-column">
			<h3>LOGIN</h3>
		</div>
		<MudGrid>
			<MudItem xs="12" >
				<MudCard>
					<MudCardContent>
						<MudTextField Label="Email" @bind-Value="Model.Email" For="@(()=>Model.Email)"/>
						<MudTextField Label="Password" Class="mt-3" @bind-Value="Model.Password" For="@(()=>Model.Password)" />
					</MudCardContent>
					<MudCardActions>
						<MudButton ButtonType="MudBlazor.ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto"> Login </MudButton>
					</MudCardActions>
				</MudCard>
			</MudItem>
				<MudItem xs="12">
					<MudText Typo="Typo.body2" Align="Align.Center">
						<MudText Color="Color.Error" disabled="IsLogging">@errorMessage</MudText>
					</MudText>
				</MudItem>

		</MudGrid>
		@*
		<div class="mb-3">
			<label>Email</label>
			<InputText @bind-Value="Model.Email" class="form-control" placeholder="Email@Email.com" />
			<ValidationMessage For="()=>Model.Email" />
		</div>

		<div class="mb-3">
			<label>Password</label>
			<InputText @bind-Value="Model.Password" placeholder="Password" typeof="password" class="form-control" />
			<ValidationMessage For="()=> Model.Password" />
		</div>
		<div class="mb-3 text-center">
			<span class="text-danger">@errorMessage</span>
		</div>
		<div class="mb-3 d-grid gap-2">
			<button type="submit" disabled="@IsLogging" class="btn btn-primary">Login</button>
		</div>
		*@
	</EditForm>


}



