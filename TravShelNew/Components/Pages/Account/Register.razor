@page "/register"

@rendermode InteractiveServer

@inject DataContext dataContext
@inject NavigationManager navigationManager




<div class="row">
	<EditForm Model="@Model" OnValidSubmit="Registration" FormName="RegisterForm">
		<DataAnnotationsValidator />
		<div class="mb-3 text-center flex-column">
			<h3>REGISTER</h3>
		</div>
		<div class="mb-3">
			<label>Forename</label>
			<InputText @bind-Value="Model.Forename" class="form-control" placeholder="John" />
			<ValidationMessage For="() => Model.Forename" />
		</div>
		<div class="mb-3">
			<label>Surename</label>
			<InputText @bind-Value="Model.Surename" class="form-control" placeholder="Carmac" />
			<ValidationMessage For="() => Model.Surename" />
		</div>
		<div class="mb-3">
			<label>Date of birth</label>
			<InputDate @bind-Value="Model.DOB" class="form-control" placeholder="@DateTime.Now" />
			<ValidationMessage For="() => Model.DOB" />
		</div>
		<div class="mb-3">
			<label>Email</label>
			<InputText @bind-Value="Model.Email" class="form-control" placeholder="Email@Email.com" />
			<ValidationMessage For="() => Model.Email" />
		</div>

		<div class="mb-3">
			<label>Password</label>
			<InputText @bind-Value="Model.Password" placeholder="Password" typeof="password" class="form-control" />
			<ValidationMessage For="()=> Model.Password" />
		</div>
		<div class="mb-3 text-center">
			<span class="text-danger">@errorMessage</span>
		</div>
		<div class="mb-3 d-grid gap-2">
			<button type="submit" class="btn btn-primary">register</button>
		</div>

	</EditForm>

</div>

