@page "/{UserId:int}/trip={TripId:int}/createDay"

@rendermode InteractiveServer
@using RazorComponents;

@using Newtonsoft.Json.Linq;
@using System.Globalization;
@using TravShell.App.GoogleAPI
@using TravShell.App.Trips;

@using TravShell.App.Attractions;

@using MudBlazor.Utilities;

@inject DataContext dataContext
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider ASP

@attribute [Authorize]


@if(IsAuth)
{
<NavigationLock ConfirmExternalNavigation="@NotSaved" OnBeforeInternalNavigation="@OnBeforeInternalNavigation"></NavigationLock>
@if(IsLoading)
{ <MudContainer style=" margin: auto;  width: 60vw; min-width:400px; padding: 10px;">
    <MudProgressLinear Color="Color.Primary" Buffer="true" Value="@Value" BufferValue="@BufferValue" Class="my-7" >
        
    </MudProgressLinear>
    <MudText Typo="Typo.subtitle1" Color="Color.Dark">
        <b>@Status</b>
    </MudText>
    </MudContainer>
}
else
{
    
    @if (trip == null || currentDate == trip.Lastdate)
    {
        <h3>Day: @currentDate.ToShortDateString() -> This is the last day!</h3>
    }
    else
    {
        <h3>Day: @currentDate.ToShortDateString()</h3>
    }
    @*<div class="d-flex flex-column mud-width-full mud-height-full">*@
   
    <MudToolBar Class="gap-4">
        <MudButton  Variant="Variant.Filled" Color="Color.Default">???</MudButton>
        <MudButton OnClick="PreviousDay" Variant="Variant.Filled" Color="Color.Primary">Prev. day</MudButton>

        @if (trip == null || currentDate == trip.Lastdate)
        {
                
                    <MudButton OnClick="SaveDayAttractions" Disabled="WaitForGoogle" ButtonType="MudBlazor.ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                Finish trip
            </MudButton>
             
        }
        else
        {
                
                <MudButton OnClick="SaveDayAttractions" Disabled="WaitForGoogle" ButtonType="MudBlazor.ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                Next Day
            </MudButton>
                
        }
   
        <MudPopover Open="@IsPopup" Fixed="true" Class="px-4 pt-4">
            <div class="d-flex flex-column">
                <MudText>Your list of attractions is empty... in order to proceed choose one.</MudText>
                <MudButton OnClick="@ToggleOpen" Class="ml-auto mr-n3 mb-1" Color="Color.Error">Close</MudButton>
            </div>
        </MudPopover>
        <MudSpacer />
        <MudButton  Variant="Variant.Text" Color="Color.Error">???</MudButton>
    </MudToolBar>
    <MudContainer style=" margin: auto;  width: 60vw; min-width:500px; padding: 10px;">

    <MudDropContainer T="AttractionViewModel" Items="@_dropzoneItems" @ref="_container" ItemsSelector="@((att,dropzone) => att.dropzone == dropzone)" ItemDropped="ItemUpdated" >
          <ChildContent>
        <div class="columns-container">
            <MudPaper Class="column">
                <MudList T="string" Class="d-flex flex-column mud-height-full">
                    <MudListSubheader>Your attractions</MudListSubheader>
                    <MudDropZone T="AttractionViewModel" Identifier="0" Class="flex-grow-1" AllowReorder="true" />
                </MudList>
            </MudPaper>

                <GoogleMap @ref="googleMapRef"
                           ApiKey="@TravShell.App.GoogleAPI.GoogleService.apiKey"
                           Center="@center"
                           Height="300"
                           Width="60"
                           Zoom="12"
                           Clickable="true" />
            </div>

            <div class="columns-container">

                @for (int i = 1; i <= 3; i++)
                {
                    var dropzone = i.ToString();
                    <MudPaper Class="column">
                        <MudList T="string" Class="d-flex flex-column mud-height-full">
                            <MudListSubheader>
                                @if(dropzone =="1")
                                {
                                  <p>Tourist Attractions</p>
                                }
                                
                                 @if(dropzone =="2")
                                {
                                  <p>Restaurants</p>
                                }
                                @if (dropzone == "3")
                                {
                                    <p>Accommodation</p>
                                }
                            
                            </MudListSubheader>
                            <MudDropZone T="AttractionViewModel" Identifier="@dropzone" CanDrop="@((item) => false)" Class="flex-grow-1" AllowReorder="true" />
                        </MudList>
                    </MudPaper>
                }
            </div>
        </ChildContent>
        <ItemRenderer>
            @if (context.dropzone == "0")
            {
                <MudListItem T="string" Text="@($"{context.Name} ({context.step})")">
                    @($"{context.Name} ({context.step +1})")
                    <MudButton OnClick="()=>removeAttraction(context)" Variant="Variant.Filled" Color="Color.Error">Remove</MudButton>
                </MudListItem>
            }
            else
            {
                <MudListItem T="string" Text="@($"{context.Name} ({context.step})")">
                    @($"{context.Name}, rating: {context.Rating}")

                </MudListItem>
            }
        </ItemRenderer>
    </MudDropContainer>
    </MudContainer>
    }


    @*</div>*@
}
else
{
    <h1>Not Authorized</h1>
    <h1>Or Trip Does Not Exist</h1>
}

@code {
    [Inject]
    public required IUserService UserService { get; set; }

    [Inject]
    public required ITripService TripsService { get; set; }

    [Inject]
    public required IAttractionService AttractionService { get; set; }

    [Inject]
    public required IGoogleService GoogleService { get; set; }

    private bool IsAuth = true;

    [Parameter]
    public int UserId { get; set; }
    [Parameter]
    public int TripId { get; set; }

    public List<AttractionViewModel> selectedAttractions = new List<AttractionViewModel>();

    public string CityName { get; set; } = "Czestochowa";

    public Trip trip { get; set; }

    public DateTime currentDate { get; set; }

    public string? coordinates { get; set; }

    public int numOfAtt = 1;

    public static List<AttractionViewModel> Tourist_Attractions = new List<AttractionViewModel>();
    public static List<AttractionViewModel> Restaurants = new List<AttractionViewModel>();
    public static List<AttractionViewModel> Accommodations = new List<AttractionViewModel>();

    GoogleMap googleMapRef = default!;

    public GoogleMapCenter center ;
    public List<GoogleMapMarker> markers = new();

    private List<AttractionViewModel> _dropzoneItems = new();

    private List<MudItemDropInfo<AttractionViewModel>> addedAtts = new();

    private MudDropContainer<AttractionViewModel> _container;

    public bool WaitForGoogle = true;

    public int LastAttIndex = 0;

    private bool NoSelectedTrips = true;

    private bool IsPopup = false;

    private bool IsLoading = true;

    public int Value = 0;

    public int BufferValue = 0;

    public string Status = "Loading tourist attractions... 0%";
    [Inject] IJSRuntime? JsRuntime { get; set; }
    private bool NotSaved { get; set; } = true;




    protected override async Task OnParametersSetAsync()
    {

        NotSaved = true;
        selectedAttractions = new List<AttractionViewModel>();

        if (trip == null)
        {
            trip = await TripsService.FindTripById(TripId);
            if (trip == null) 
            {
                IsAuth = false;
                StateHasChanged();
                return;
            }
            Authenticate();

            if (IsAuth == false)
            {
                return;
            }


            currentDate = trip.Firstdate;

            CityName = trip.City;

            center = new GoogleMapCenter(trip.latitude, trip.longitude);
        }

        if (Tourist_Attractions.Count() == 0 || Restaurants.Count() == 0 || Accommodations.Count() == 0)
        {
            coordinates = $"{trip.latitude.ToString(CultureInfo.InvariantCulture)}%2C{trip.longitude.ToString(CultureInfo.InvariantCulture)}";
        }

        if (Tourist_Attractions.Count() == 0)
        {
            await GetSetAttractions(coordinates, AttractionType.Attraction, Tourist_Attractions);
        }

        await SimulateProgressAsync("Loading restaurants... 30%");

        if (Restaurants.Count() == 0)
        {
            await GetSetAttractions(coordinates, AttractionType.Restaurant, Restaurants);
        }
        await SimulateProgressAsync("Loading accommodations... 60%");            

        if (Accommodations.Count() == 0)
        {
            await GetSetAttractions(coordinates, AttractionType.Accommodation, Accommodations);
        }
        await SimulateProgressAsync("Finalizng... 90%");

        if (_dropzoneItems.Count() == 0)
        {
            PopulateAllDropZones();
        }

        await SimulateProgressAsync("Get ready 100%");

        WaitForGoogle = false;
        if(_container == null)
        {
            _container = new();
        }
        RefreshContainer();
    }

    private async void Authenticate()
    {


        var authState = await ASP.GetAuthenticationStateAsync();

        if (authState.User.Identity.IsAuthenticated)
        {
            if (Int32.Parse(authState.User.Identity.Name) == trip.User.UserId)
            {
                IsAuth = true;
                StateHasChanged();
            }
            else
            {
                IsAuth = false;
                StateHasChanged();
                return;
            }
        }
        else
        {
            IsAuth = false;
            StateHasChanged();
            return;
        }
    }

    public async Task SimulateProgressAsync(string status)
    {
        Status =status;
        Value += 30;
        BufferValue += 35;
        StateHasChanged();
        await Task.Delay(500);
        if(Value>= 100)
        {
            IsLoading = false;
            StateHasChanged();
            await Task.Delay(500);
        }
    }

    private void PopulateDropzone(List<AttractionViewModel> list, string dropzone)
    {
        foreach (var att in list)
        {
            att.dropzone = dropzone;

            att.step = LastAttIndex++;

            _dropzoneItems.Add(att);
        }
    }

    private void ToggleOpen()
    {
        IsPopup = !IsPopup;
    }

    private void Reorder()
    {
        List<AttractionViewModel> nItems = _dropzoneItems.OrderBy(x => x.step).ToList();
        for (var i = 0; i < _dropzoneItems.Count(); i++)
        {
            nItems[i].step = i;
        }

        _dropzoneItems = nItems;
        RefreshContainer();
    }

    private async void ItemUpdated(MudItemDropInfo<AttractionViewModel> att)
    {
        ItemAdded(att);

        _dropzoneItems.UpdateOrder(att, item => item.step, 0);

        Reorder();

        foreach (var a in _dropzoneItems.Where(x => x.dropzone == "0"))
        {
            foreach (var m in markers)
            {
                if (m == a.Marker)
                {
                    m.PinElement = new PinElement
                        {
                            Glyph = (a.step +1) + "",
                            GlyphColor = "white"
                        };
                }
            }
        }
        await googleMapRef.UpdateMarkersAsync(markers);
    }

    private AttractionViewModel CopyAttraction(AttractionViewModel att)
    {
        var AVM = new AttractionViewModel()
            {
                PlaceCode = att.PlaceCode,
                Name = att.Name,
                Vicinity = att.Vicinity,
                Rating = att.Rating,
                Opening_Hours = att.Opening_Hours,
                Website = att.Website,
                Type = att.Type,
                StartDate = currentDate,
                step = att.step,
                latitude = att.latitude,
                longitude = att.longitude,
                Trip = trip,
                Marker=att.Marker,
                dropzone = att.dropzone
            };
        return AVM;
    }

    private GoogleMapMarker CreateMapMarker(AttractionViewModel att)
    {
        var marker = new GoogleMapMarker()
            {
                Position = new GoogleMapMarkerPosition(att.latitude, att.longitude),

                PinElement = new PinElement
                {
                    Glyph = (att.step + 1) + "",
                    GlyphColor = "white"
                },
                Title = att.Website != "Website is not available." ? $" <a target = '_blank' jstcache = '6' href = '{att.Website}' tabindex = '0'> <span> Check the website!</span> </a> " : "<h4> No Website available </h4>"
                // Title = $" place: {att.Name}",
                // Content= ""+newAttraction.Id
            };

        return marker;
    }

    private void ItemAdded(MudItemDropInfo<AttractionViewModel> att)
    {
        AttractionViewModel AVM = null;

        if (att.Item.dropzone == "1" || att.Item.dropzone == "2" || att.Item.dropzone == "3")
        {
            if (att.DropzoneIdentifier == "0")
            {
                AVM = CopyAttraction(att.Item);
                _dropzoneItems.Add(AVM);

                att.Item.dropzone = att.DropzoneIdentifier;

                _dropzoneItems.UpdateOrder(att, item => item.step, 0);

                Reorder();

                var marker = CreateMapMarker(att.Item);

                AVM.Marker = marker;
                markers.Add(marker);
                att.Item.Marker = marker;

                markers.OrderBy(x => x.PinElement.Glyph);

                NoSelectedTrips = false;

                addedAtts.Add(att);
            }
        }
    }

    private async void RefreshMap()
    {
        await googleMapRef.RefreshAsync();
        await googleMapRef.UpdateMarkersAsync(markers);
    }

    private void RefreshContainer()
    {
        //update the binding to the container
        StateHasChanged();

        //the container refreshes the internal state
        _container.Refresh();
    }

    private void PopulateAllDropZones()
    {
        PopulateDropzone(Tourist_Attractions, "1");
        PopulateDropzone(Restaurants, "2");
        PopulateDropzone(Accommodations, "3");        
    }

    public async Task SaveDayAttractions()
    {
        bool isDayRepeated = false;
        if(NoSelectedTrips)
        {
            IsPopup = true;
            StateHasChanged();
            await Task.Delay(1);
            return;
        }
        List<AttractionViewModel> nList = new();

        foreach (var att in _dropzoneItems.Where(x => x.dropzone == "0").ToList())
        {
            nList.Add(CopyAttraction(att));
        }
        selectedAttractions.AddRange( nList);

        if(currentDate != trip.Lastdate)
        {
            currentDate = currentDate.AddDays(1);

            markers.Clear();

            if (selectedAttractions.Where(x => x.StartDate == currentDate).Count()>0)
            {
                isDayRepeated = true;

                NoSelectedTrips = false;

                markers.Clear();
                nList = new();
                foreach (var att in selectedAttractions.Where(x => x.StartDate == currentDate).ToList())
                {
                    var marker = CreateMapMarker(att);

                    markers.Add(marker);
                    att.Marker = marker;

                    nList.Add(CopyAttraction(att));
                }
                selectedAttractions.RemoveAll(x => x.StartDate == currentDate);
                _dropzoneItems.Clear();
                LastAttIndex = 0;
                PopulateDropzone(nList, "0");

                PopulateAllDropZones();

                await googleMapRef.UpdateMarkersAsync(markers);

                RefreshContainer();
                StateHasChanged();
                await Task.Delay(1);
            }
            await googleMapRef.UpdateMarkersAsync(markers);
        }
        else
        {
            await AttractionService.SaveAttractionList(selectedAttractions);
            Tourist_Attractions = new List<AttractionViewModel>();
            Restaurants = new List<AttractionViewModel>();
            Accommodations = new List<AttractionViewModel>();
            selectedAttractions = new List<AttractionViewModel>();
            trip = null;

            markers.Clear();
            await googleMapRef.RefreshAsync();

            WaitForGoogle = true;

            LastAttIndex = 0;

            NoSelectedTrips = true;

            IsPopup = false;

            IsLoading = true;

            Value = 0;

            BufferValue = 0;

            Status = "Loading tourist attractions... 0%";

            NotSaved = false;
            navigationManager.NavigateTo($"/trips/{UserId}");
        }

        if (!isDayRepeated)
        {
            _dropzoneItems.RemoveAll(x => x.dropzone == "0");
            Reorder();
            NoSelectedTrips = true;
        }
    }

    private async void PreviousDay()
    {
        if (currentDate > trip.Firstdate)
        { 
            List<AttractionViewModel> nList = new();

            foreach (var att in _dropzoneItems.Where(x => x.dropzone == "0").ToList())
            {
                nList.Add(CopyAttraction(att));
            }
            selectedAttractions.AddRange(nList);

            currentDate = currentDate.AddDays(-1);

            NoSelectedTrips = false;

            markers.Clear();
            nList = new();
            foreach (var att in selectedAttractions.Where(x => x.StartDate == currentDate).ToList())
            {
                var marker = CreateMapMarker(att);
      
                markers.Add(marker);

                var tmpAVM = CopyAttraction(att);
                tmpAVM.Marker = marker;
                nList.Add(tmpAVM);
            }

            selectedAttractions.RemoveAll(x => x.StartDate == currentDate);
            _dropzoneItems.Clear();
            LastAttIndex = 0;
            PopulateDropzone(nList, "0");

            PopulateAllDropZones();
       
            await googleMapRef.UpdateMarkersAsync(markers);

            RefreshContainer();
             StateHasChanged();
            await Task.Delay(1);
        }
    }

    public async Task removeAttraction(AttractionViewModel att)
    {
        _dropzoneItems.Remove(att);

        Reorder();
        markers.Remove(att.Marker);
        markers.Clear();

        foreach (var a in _dropzoneItems.Where(x=> x.dropzone=="0").ToList())
        {
            a.Marker.PinElement.Glyph = (a.step +1) + "";

            markers.Add(a.Marker);
        }
        await googleMapRef.UpdateMarkersAsync(markers);
        if (_dropzoneItems.Where(x => x.dropzone == "0").Count()==0)
        {
            NoSelectedTrips = true;
            StateHasChanged();
            await Task.Delay(1);
        }
    }

    public async Task GetSetAttractions(string coords, AttractionType type, List<AttractionViewModel> list)
    {
        var populatedList = await GoogleService.GetSetAttractions(coords, type, list);

        list = await GoogleService.GetSetAttractionsDetails(populatedList);
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (JsRuntime is null) return;

        if (NotSaved)
        {
            var isConfirmed = await JsRuntime.InvokeAsync<bool>("confirm",
                "Changes will be lost. Still want to leave the page?");

            if (!isConfirmed)
            {
                context.PreventNavigation();
            }
            else
            {
                Tourist_Attractions = new List<AttractionViewModel>();
                Restaurants = new List<AttractionViewModel>();
                Accommodations = new List<AttractionViewModel>();
                selectedAttractions = new List<AttractionViewModel>();
                trip = null;

                markers.Clear();

                WaitForGoogle = true;

                LastAttIndex = 0;

                NoSelectedTrips = true;

                IsPopup = false;

                IsLoading = true;

                Value = 0;

                BufferValue = 0;

                Status = "Loading tourist attractions... 0%";
                await TripsService.RemoveTripById(TripId);
            }
        }
    }
}


    <style>

