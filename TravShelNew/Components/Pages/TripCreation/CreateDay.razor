@page "/{UserId:int}/trip={TripId:int}/createDay"

@*@page "/{UserId:int}/trip/{TripName}/1"
@page "/{UserId:int}/trip/{TripId:int}/{Date:DateTime}"
*@
@rendermode InteractiveServer
@using RazorComponents

@using Newtonsoft.Json.Linq;
@using System.Globalization;
@using TravShell.App.GoogleAPI
@using TravShell.App.Trips;

@using TravShell.App.Attractions;



@inject DataContext dataContext
@inject NavigationManager navigationManager


<h3>Day: @currentDate.ToShortDateString()</h3>
@if(trip ==null ||currentDate == trip.Lastdate)
{
    <h3>This is the last day!</h3>
}


<div class="top-column">
    <span>Your selected activities</span>
    @foreach(var att in selectedAttractions)
    {
        <div style="display:inline-flex">
        <button class="btn btn-primary" style="width:60vw" @onclick="()=>removeAttraction(att)"> @att.Name
            
          
        </button>
            <InputNumber @bind-Value="att.step" style="justify-content:space-between" />
            </div>
    }
</div>
<EditForm Model="selectedAttractions" OnValidSubmit="SaveDayAttractions" FormName="DayTimetable">
    <button type="submit" class="btn btn-primary">Go to next day/ finish trip</button>
</EditForm>

<GoogleMap @ref="googleMapRef"
           ApiKey="@TravShell.App.GoogleAPI.GoogleService.apiKey"
           Center="@center"
           Height="400"
           Width="100"
           Zoom="12"
           Markers="markers" 
           Clickable="true"/>

<div class="columns-container">
    <div class="column">
        <p>Attractions</p>
        @foreach(var att in Tourist_Attractions)
        {
            <button class="btn btn-primary" @onclick="()=>addAttraction(att)">@att.Name</button>
        }
    </div>
    <div class="column">
        <p>Restaurants</p>
        @foreach (var att in Restaurants)
        {
            <button class="btn btn-primary" @onclick="()=>addAttraction(att)">@att.Name</button>
        }
    </div>
    <div class="column">
        <p>Accommodations</p>
        @foreach (var att in Accommodations)
        {
            <button class="btn btn-primary" @onclick="()=>addAttraction(att)">@att.Name</button>
        }
    </div>
</div>

