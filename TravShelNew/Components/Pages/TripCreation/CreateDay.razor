<style>

    .top-column {
        width: 100%;
        margin-bottom: 20px; /* Adds space between the top column and the bottom columns */
        display: flex;
        flex-direction: column; /* Ensures buttons stack vertically */
         /* You can adjust this value */
        overflow-y: auto; /* Enables vertical scrolling for the top column if needed */

        height: 50vh;
    }

    .columns-container {
        display: flex;
        justify-content: space-between; /* Ensures the columns are opposite each other */
        width: 100%;
    }

    .column {
        width: 30%; /* Adjust the width of the columns as needed */
        max-height: 300px; /* Set a max height to trigger the scrollbar */
        overflow-y: auto; /* Enables the vertical scroll bar */
        border: 1px solid #ccc;
        padding: 10px;
    }

    .btn {
        display: block;
        margin-bottom: 10px;
    }


</style>