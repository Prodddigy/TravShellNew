	public async Task EditTrip()//nie działa jeszcez
	{
		if (Model.Firstdate >= DateTime.Now.Date && Model.Lastdate >= Model.Firstdate)
		{

			if (Model.Firstdate < Model.Lastdate)
			{
				errorMessage = null;
				var t =	 dataContext.Trips.Where(x => x.Id == TripId).FirstOrDefault();

				t.Name = Model.Name;
				t.Firstdate = Model.Firstdate;
				t.Lastdate = Model.Lastdate;
				t.Days = (Model.Lastdate - Model.Firstdate).Days;

				await dataContext.SaveChangesAsync();
				navigationManager.NavigateTo($"/{UserId}/trip/{t.Id}/1");

			}
			else if (Model.Firstdate == Model.Lastdate)
			{
				errorMessage = null;
				var t = dataContext.Trips.Where(x => x.Id == TripId).FirstOrDefault();

				t.Name = Model.Name;
				t.Firstdate = Model.Firstdate;
				t.Lastdate = Model.Lastdate;
				t.Days = 1;

				await dataContext.SaveChangesAsync();
				navigationManager.NavigateTo($"/{UserId}/trip/{t.Id}/1");
			}
			else
			{
				errorMessage = "Dates are mixed up";
			}
		}
		else
		{
			errorMessage = "dates are in the past";
		}

	}
