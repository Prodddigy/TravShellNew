@page "/createTrip/{UserId:int}/newTrip"

@rendermode InteractiveServer
@using RazorComponents
@using Microsoft.AspNetCore.Authorization
@using TravShell.App.GoogleAPI
@using TravShell.App.Trips

@using GoogleApi.Entities.Common;
@using GoogleApi.Entities.Common.Enums;
@using GoogleApi.Entities.Places.QueryAutoComplete.Request;
@using GoogleApi;
@using GoogleApi.Entities.Places.AutoComplete.Request;

@attribute [Authorize]
@inject DataContext dataContext
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider ASP

@if(IsAuth)
{
	<div class="mb-3 text-center flex-column">
	<h3>New trip!</h3>

</div>
	<EditForm Model="Model"  OnValidSubmit="VerifyLocation" FormName="InitialTripCreationForm" style=" margin: auto;  width: 50%;
  padding: 10px;">

	<DataAnnotationsValidator />
	
	<MudGrid>
			<MudItem xs="12" sm="6">
			<MudCard>
					<MudCardContent @onclick="RevokeVerification">
						<MudTextField   Label="Trip name" @bind-Value="Model.Name" For="@(()=>Model.Name)" />
						<MudDatePicker Adornment="Adornment.None" Label="Start date" @bind-Date="Model.Firstdate" PickerVariant="PickerVariant.Dialog" Class="mt-3" For="@(()=>Model.Firstdate)" />
						<MudDatePicker Adornment="Adornment.None" Label="Last date" @bind-Date="Model.Lastdate" PickerVariant="PickerVariant.Dialog" Class="mt-3" For="@(()=>Model.Lastdate)" />
							<MudTooltip Text="Hint: You don't have to choose city, instead try anything you want!">
						<MudAutocomplete OnClearButtonClick="RevokeVerification"  @onclick="RevokeVerification"  T="string" Label="Search for places"
										 Placeholder="Start typing..."
										 SearchFunc="SearchPlacesAsync"
										 Clearable="true"
										 CoerceText="true"
										 ResetValueOnEmptyText="true" @bind-Value="Model.City" For="@(()=>Model.City)" />
						</MudTooltip>

						<MudTextField Label="Short description" Immediate="true" Counter="40" MaxLength="40" @bind-Value="Model.ShortDescription" Class="mt-3" For="@(()=>Model.ShortDescription)" AutoGrow MaxLines="4" Variant="Variant.Text" />
					
						
						<MudCheckBox @onclick="RevokeVerification"  Label="Public" @bind-Value="Model.IsPublic" Class="mt-3" For="@(()=>Model.IsPublic)" Color="Color.Primary" />
				</MudCardContent>

					<MudCardActions>
						<MudButton ButtonType="MudBlazor.ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto"> Verify details </MudButton>
					</MudCardActions>
					
			</MudCard>
			
			
		</MudItem>
		

			<MudItem xs="12" sm="6">
				<MudPaper Class="pa-4 mud-height-full">
			<GoogleMap @ref="googleMapRef"
			   ApiKey="@TravShell.App.GoogleAPI.GoogleService.apiKey"
			   Center="@center"
			   Height="350"
			   Width="100"
			   Zoom="@zoom"
			   Markers="markers"
		   />
				<MudButton Disabled="isNotVerified" OnClick="SaveTrip" Variant="Variant.Filled" Size="Size.Small" Color="Color.Success">Start planning!</MudButton>
			
			</MudPaper>
			</MudItem>

			<MudItem xs="12">
				<MudText Typo="Typo.body2" Align="Align.Center">
					<MudText Color="Color.Error">@errorMessage</MudText>
				</MudText>
		</MudItem>

	</MudGrid>
	</EditForm>
}
else
{
	<h1>Restricted Area</h1>
}

@code {
	[Inject]
	public required IUserService UserService { get; set; }

	[Inject]
	public required ITripService TripsService { get; set; }

	[Inject]
	public required IGoogleService GoogleService { get; set; }

	[SupplyParameterFromForm]
	public TripViewModel Model { get; set; } = new();

	[Parameter]
	public int UserId { get; set; }

	[Parameter]
	public int TripId { get; set; } = -1;

	public bool isNotVerified { get; set; } = true;
	public int zoom = 5;

	public User user { get; set; }

	GoogleMap googleMapRef = default!;

	public GoogleMapCenter center = new GoogleMapCenter(51.919438, 19.145136);
	public List<GoogleMapMarker> markers = new();


	public string? errorMessage { get; set; }

	private bool IsAuth = false;


	protected override async Task OnParametersSetAsync()
	{
		var authState = await ASP.GetAuthenticationStateAsync();

		if (authState.User.Identity.IsAuthenticated)
		{
			int userIdcheck = Int32.Parse(authState.User.Identity.Name);

			if(UserId ==userIdcheck )
			{
				user = await UserService.FindUserByIdAsync(UserId + "");
				IsAuth = true;
			}
		}
	}


	private async Task<bool> SetLocationOnMap()
	{
		if (Model.City != "" && Model.City != null)
		{
			var model = await GoogleService.GetCoordinates(Model);
			if(model == null)
			{
				errorMessage = "No such place found as: " + Model.City;

			//	Console.WriteLine("No such place founc");
				return true;
			}

			//	Console.WriteLine(model.latitude +" "+ model.longitude);
			markers.Clear();
			markers.Add(
				new GoogleMapMarker()
					{
						Position = new GoogleMapMarkerPosition(model.latitude, model.longitude),
						Title = model.City
					});

			center = new GoogleMapCenter(model.latitude, model.longitude);
			//	Console.WriteLine("yes city");
			errorMessage = "";

			zoom = 8;
			return false;

		}else
		{
			//	Console.WriteLine("no city!!!");
			return true;
		}

	}

	private async Task VerifyLocation()
	{
		//Console.WriteLine("verify?");
		bool tmp = await SetLocationOnMap();

		isNotVerified = tmp;

		StateHasChanged();
		await Task.Delay(3);
		await googleMapRef.UpdateMarkersAsync(markers);
		//await googleMapRef.
		await googleMapRef.RefreshAsync();
	}

	public async Task SaveTrip()
	{
		isNotVerified = true;
		if (Model.Firstdate >= DateTime.Now.Date && Model.Lastdate.Value.Date >= Model.Firstdate.Value.Date)
		{
			var trip_id = -1;

//			Console.WriteLine(Model.Firstdate.Value.Date +" < " + Model.Lastdate.Value.Date);

			if (Model.Firstdate.Value.Date < Model.Lastdate.Value.Date)//Multiple day trip
			{
				//Console.WriteLine(Model.Firstdate.Value.Date + "<- first tutaj last ->" + Model.Lastdate.Value.Date);
				errorMessage = null;

				var newModel = await GoogleService.GetCoordinates(Model);

				trip_id = await TripsService.CreateMultiDayTrip(newModel, user);

				navigationManager.NavigateTo($"/{UserId}/trip={trip_id}/createDay");

			}
			else if (Model.Firstdate.Value.Date == Model.Lastdate.Value.Date) //one day trip
			{
				//Console.WriteLine("==");
				errorMessage = null;

				var newModel = (await GoogleService.GetCoordinates(Model));

				trip_id = await TripsService.CreateOneDayTrip(Model, user);

				navigationManager.NavigateTo($"/{UserId}/trip={trip_id}/createDay");
			}
			else
			{
				errorMessage = "Dates are mixed up";
				isNotVerified = false;
			}
		}
		else
		{
			errorMessage = "Dates are in the past. First: "+Model.Firstdate.Value.Date.ToShortDateString()+". Second: "+Model.Lastdate.Value.Date.ToShortDateString()+".";
			isNotVerified = false;
		}	
	}

	private async Task<IEnumerable<string>> SearchPlacesAsync(string place, CancellationToken cancellationToken)
	{
		if (string.IsNullOrWhiteSpace(place))
			return Enumerable.Empty<string>();

		return await GoogleService.GetPlaceNamesAutocomplete(place,cancellationToken);
	}

	private  void RevokeVerification()
	{
		isNotVerified = true;
		StateHasChanged();

	//	Console.WriteLine("verifyrevoked");
	}

}
