@if(IsAuth)
{

	<h3>NEW CREATION</h3>
<EditForm Model="Model" OnValidSubmit="VerifyLocation" FormName="InitialTripCreationForm">

	<DataAnnotationsValidator />
	<CustomCssClassProvider ProviderType="BootstrapFieldCssClassProvider" />
	
	@*
	<InputText >
		Auto Complete search for a city
	</InputText>
	*@
	<span>Trip Name</span>
	<InputText @bind-Value="Model.Name" />
	<ValidationMessage For="()=>Model.Name" />
	<span>Trip Starting Date</span>
	<InputDate @bind-Value="Model.Firstdate" />
	<ValidationMessage For="()=>Model.Firstdate" />
	<span>Trip Ending Date</span>
	<InputDate @bind-Value="Model.Lastdate" />
	<ValidationMessage For="()=>Model.Lastdate" />
	<span>Trip City</span>
	<InputText @bind-Value="Model.City" @onblur="SetCenterOnBlur"/>
	<ValidationMessage For="()=>Model.City" />
	<span>Make it public?</span>
	<InputCheckbox @bind-Value="Model.IsPublic" style="width:20%;"  />


	<span class="text-danger">@errorMessage</span>
	
	<button type="submit" class="btn btn-success">Verify Location</button>
	</EditForm>



	<MudButton Disabled="isNotVerified" OnClick="SaveTrip" Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary">Start planning!</MudButton>


<GoogleMap @ref="googleMapRef"
		   ApiKey="@TravShell.App.GoogleAPI.GoogleService.apiKey"
		   Center="@center"
		   Height="400"
		   Width="100"
		   Zoom="8"
		   Markers="markers"
	/>

}
else
{
	<h1>Restricted Area</h1>
}


