	private async Task OnBeforeInternalNavigation(LocationChangingContext context)
	{
		if (JsRuntime is null) return;

		if (IsCreating)
		{
			var isConfirmed = await JsRuntime.InvokeAsync<bool>("confirm",
				"Changes will be lost. Still want to leave the page?");

			if (!isConfirmed)
			{
				context.PreventNavigation();
			}
			else
			{
				cts?.Cancel();
				// Tourist_Attractions = new List<AttractionViewModel>();
				// Restaurants = new List<AttractionViewModel>();
				// Accommodations = new List<AttractionViewModel>();
				// selectedAttractions = new List<AttractionViewModel>();
