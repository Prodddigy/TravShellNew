@page "/trips/{UserId:int}/{TripId:int}"

@rendermode InteractiveServer

@inject DataContext dataContext

@using TravShell.App.Attractions
@using TravShell.App.Trips
@using TravShell.Core.Entities

<h3>User id: @UserId and Trip id: @TripId</h3>


<div class="horizontal-scroll">

 @if(Attractions != null )
 {
     
@for (var i=0; i <TripDays;i++)
{         
                <div class="box">
               
                    @if(i==0)
                    {
                    <div >
                        Day @Attractions[0].StartDate
                    </div>
                }
                else
                {
                    <div >
                        Day @Attractions[0].StartDate.AddDays(i).
                    </div>
                }
                    
                    @foreach(var attraction in Attractions )
                    {
                    @if (Attractions[0].StartDate.AddDays(i) == attraction.StartDate )
                       {
                        
                        <p> @attraction.Name</p>
                        <p>Opening at: trzeba sformatować na czytelniejsze</p>
                        <p>Address: @attraction.Vicinity</p>
                        <p>Rating: @attraction.Rating</p>
                        <p>Type: @attraction.Type</p>
                        <p>------------------------</p>
                     
                    }
               
                }
                <p> END OF THE DAY</p>
                </div>

}}

</div>
   





@code {

    [Inject]
    public required IAttractionService attractionsService { get; set; }

    [Inject]
    public required ITripService tripsService { get; set; }

    [Parameter]
    public int UserId { get; set; }
    [Parameter]
    public int TripId { get; set; }

    private Attraction? prevAtt { get; set; } 

    public List<Attraction> Attractions { get; set; } = default;
    public List<Attraction> OneDayAtt { get; set; } = new();

    public int TripDays { get; set; }

    public int lastAttraction { get; set; } = -1;

    protected async override Task OnInitializedAsync()
    {
        int numOfAtt = await attractionsService.CountTripAttractions(TripId);
        //Console.WriteLine(TotalTrips + " total");
        if (numOfAtt != 0)
        {
            //GetTripAttractionsOrderByStartDate
            Attractions = await attractionsService.GetTripAttractionsOrderByStartDate(TripId);

            //Console.WriteLine(Trips[0].Name + " trip");
        }
        //FindTripById
        var trip = await tripsService.FindTripById(TripId);

        if(trip != null)
        {
            TripDays = trip.Days;
        }


      
    }



    public void setter(Attraction Att)
    {
        prevAtt = Att;
    }




}
<style>
    .horizontal-scroll {
        white-space: nowrap; /* Prevents the text from wrapping to the next line */
        overflow-x: auto; /* Enables horizontal scrolling */
        width: 100%; /* You can adjust the width as necessary */
        border: 1px solid #ccc; /* Optional: to make the container more visible */
        padding: 10px; /* Optional: space between text and container */
        max-width: 80vw;
        position: relative;


        height:80vh;
       
    }

        .horizontal-scroll span {
            display: inline-block;
            top:0px;
          
        }

      

    .box {
        display: inline-block;
        margin-right: 10px;
        border: 1px solid ;
        border-color: rebeccapurple;
        padding:10px;
      box-sizing: border-box;
        top:0;
        height:100%;
        margin-top:0px;
        
    }


</style>
