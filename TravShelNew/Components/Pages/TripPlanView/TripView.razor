@page "/trips/{UserId:int}/{TripId:int}"



@rendermode InteractiveServer

@attribute [Authorize]

@inject DataContext dataContext
@inject AuthenticationStateProvider ASP

@using TravShell.App.Attractions
@using TravShell.App.Trips
@using TravShell.Core.Entities


@if(IsAuth)
{
    @*<h3>User id: @UserId and Trip id: @TripId</h3>*@

    if(TripExists)
    {

    <MudToolBar Class="gap-4">
        <h3>Trip: @TripName</h3>
        <MudSpacer />
        <MudButton  Variant="Variant.Text" Color="Color.Error">???</MudButton>
        </MudToolBar>

<MudCarousel Class="mud-width-full" @ref="_carousel" ItemsSource="@_source" Style="height:200px;" ShowArrows="true" ShowBullets="false" EnableSwipeGesture="true" AutoCycle="false" @bind-SelectedIndex="staticIndex">
    <ItemTemplate>
        <div class="horizontal-scroll" style="height:100%">
            <h1>@context.First().StartDate.ToShortDateString() Day @(selectedIndex+1) / @TripDays </h1>
        @foreach (var attraction in @context)
        {
            <h1>@(context.IndexOf(attraction)+1)</h1>
          
            <p> @attraction.Name</p>
            <p>Opening at: @attraction.Opening_Hours</p>
            <p>Address: @attraction.Vicinity</p>
            <p>Rating: @attraction.Rating</p>
            <p>Type: @attraction.Type</p>
            <p>------------------------</p>
        }
        </div>

    </ItemTemplate>
    
    <PreviousButtonTemplate>
        <div @onclick="GoLeft" Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon">
            <span class="mud-icon-button-label">
                <MudIcon  Class="mud-ripple mud-ripple-icon mud-icon-button-size-medium" Icon="@Icons.Material.Filled.SkipPrevious" Color="@Color.Inherit" />
            </span>
        </div>
    </PreviousButtonTemplate>
    <NextButtonTemplate>
        <div @onclick="GoRight" Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon">
            <span class="mud-icon-button-label">
                <MudIcon  Class="mud-ripple mud-ripple-icon mud-icon-button-size-medium" Icon="@Icons.Material.Filled.SkipNext" Color="@Color.Inherit" />
            </span>
        </div>
    </NextButtonTemplate>

</MudCarousel>


<GoogleMap @ref="googleMapRef"
           ApiKey="@TravShell.App.GoogleAPI.GoogleService.apiKey"
           Center="@center"
           Height="300"
           Width="60"
           Zoom="12"
           Markers="markers" 
        Clickable="true"/>
    }
    else
    {
        <h1>Trip @TripId does not exist</h1>
    }

}
else
{
    <h1>Not Authorized</h1>
}



@code {

    [Inject]
    public required IAttractionService attractionsService { get; set; }

    [Inject]
    public required ITripService tripsService { get; set; }

    [Parameter]
    public int UserId { get; set; }
    [Parameter]
    public int TripId { get; set; }

    public List<Attraction> Attractions { get; set; } = default;

    public Dictionary<DateTime, List<Attraction>> AttractionMap { get; set; } = new();

    public int TripDays { get; set; }

    GoogleMap googleMapRef = default!;

    public GoogleMapCenter center /*= new GoogleMapCenter(37.50024109655184, -122.28528451834352)*/;
    public List<GoogleMapMarker> markers = new();

    public List<List<GoogleMapMarker>> AllMarkers = new();

    public Trip currentTrip { get; set; }
    public string TripName { get; set; } = "Loading...";

    private MudCarousel<List<Attraction>> _carousel;
    private IList<List<Attraction>> _source = new List<List<Attraction>>();

    private int staticIndex = 0;

    private int selectedIndex = 0;

    private bool IsAuth = false;

    private bool TripExists = true;


    protected async override Task OnInitializedAsync()
    {
        var authState = await ASP.GetAuthenticationStateAsync();

        if (authState.User.Identity.IsAuthenticated)
        {
            int userIdCheck = Int32.Parse(authState.User.Identity.Name);

            if(userIdCheck == UserId)
            {
                IsAuth = true;

                currentTrip = await tripsService.FindTripById(TripId);

                if(currentTrip == null)
                {
                    TripExists = false;
                    return;
                }

                TripName = currentTrip.Name;
                int numOfAtt = await attractionsService.CountTripAttractions(TripId);
                //Console.WriteLine(TotalTrips + " total");
                if (numOfAtt != 0)
                {
                    Attractions = await attractionsService.GetTripAttractionsOrderByStartDate(TripId);

                    DateTime tmp = Attractions.First().StartDate;

                    List<Attraction> tmpList = new();
                    foreach(var a in Attractions)
                    {
                        if (a.StartDate == tmp )
                        {
                            tmpList.Add(a);
                        }
                        else
                        {
                            AttractionMap.Add(tmp, tmpList);

                            tmp=a.StartDate;

                            tmpList = new();

                            tmpList.Add(a);

                            if(Attractions.Last()==a)
                            {
                                AttractionMap.Add(tmp, tmpList);
                                break;
                            }
                }

                if (Attractions.Last() == a)
                {
                    AttractionMap.Add(tmp, tmpList);
                }
            }

//            Console.WriteLine(AttractionMap.Keys.Count()+ " <---count");
            foreach (var a in AttractionMap)
            {
                _source.Add(a.Value.OrderBy(x=>x.step).ToList());
            }

            int i = 1;
            foreach(var a in AttractionMap)
            {
                i = 1;

                var newMarkers = new List<GoogleMapMarker>();
 
                foreach(var aa in a.Value.OrderBy(x=>x.step).ToList())
                {
                    newMarkers.Add(new GoogleMapMarker()
                        {
                            Position = new GoogleMapMarkerPosition(aa.latitude, aa.longitude),

                            PinElement = new PinElement
                            {
                                Glyph = (i++) + "",
                                GlyphColor = "white",
                                Background = "Purple"

                            },


                            Title = aa.Website != "Website is not available." ? $" <a target = '_blank' jstcache = '6' href = '{aa.Website}' tabindex = '0'> <span> Check the website!</span> </a> " : "<h1> No Website available </h1>",
                        });
                }
                AllMarkers.Add(newMarkers);

                    }
            markers = AllMarkers[0];
        }
        
        var trip = await tripsService.FindTripById(TripId);

        if(trip != null)
        {
            TripDays = trip.Days;
            center = new GoogleMapCenter(trip.latitude, trip.longitude);
        }
        StateHasChanged();
        await Task.Delay(3);
        await googleMapRef.RefreshAsync();

//        await InvokeAsync(StateHasChanged);

            }
        }
    }

    private async void RefreshMap()
    {
        await googleMapRef.RefreshAsync();
        await googleMapRef.UpdateMarkersAsync(markers);
    }


    private async Task GoLeft()
    {
        selectedIndex--;

        if(selectedIndex<0)
        {
            markers = AllMarkers.Last();
            selectedIndex = TripDays - 1;
        }
        else
        {
            markers = AllMarkers[selectedIndex];
        }

        await googleMapRef.UpdateMarkersAsync(markers);
        await InvokeAsync(StateHasChanged);
      //  Console.WriteLine("Left: " + selectedIndex);
    }

    private async Task GoRight()
    {
        selectedIndex++;


        if (selectedIndex >= TripDays)
        {

            selectedIndex = 0;

            markers = AllMarkers.First();
        }
        else
        {
            markers = AllMarkers[selectedIndex];
        }

        await googleMapRef.UpdateMarkersAsync(markers);
        await InvokeAsync(StateHasChanged);
     //   Console.WriteLine("Right: "+ selectedIndex);
    }


}
