@page "/trips/{UserId:int}/{TripId:int}"

@rendermode InteractiveServer

@attribute [Authorize]

@inject AuthenticationStateProvider ASP
@inject NavigationManager navi

@inject ISnackbar Snackbar

@using TravShell.App.Attractions
@using TravShell.App.Tags
@using TravShell.App.Trips
@using TravShell.Core.Entities
@using Markdig

@if(IsAuth)
{
    @*<h3>User id: @UserId and Trip id: @TripId</h3>*@
     @if(!IsTripComplete)
    {
        <h1>This trip is incomplete, please edit or delte it.</h1>
    }
    else
    {

    if(TripExists)
    {
        <MudText Style="@($"color:{Colors.Purple.Darken4};")" Typo="Typo.h3">@TripName</MudText>  
   
        <MudContainer style=" margin: auto;  width: 60vw; min-width:700px; padding: 10px;">
    <MudGrid>
    <MudItem>
        @if(isPublic)
        {
            <MudText Style="width:10px;">Unpublish</MudText>
                        <MudIconButton Disabled="IsPublishProcess" OnClick="async ()=> await ChangeVisbility(false)" Icon="@Icons.Material.Filled.PublicOff" Color="Color.Error" Size="Size.Large" />
        }
        else
        {
            <MudText Style="width:10px;">Publish</MudText>
                        <MudIconButton Disabled="IsPublishProcess" OnClick="async ()=> await ChangeVisbility(true)" Icon="@Icons.Material.Filled.Public" Color="Color.Tertiary" Size="Size.Large" />
        }
    </MudItem>
        <MudItem xs="7" > 
<MudCarousel Class="mud-width-full" @ref="_carousel" ItemsSource="@_source" Style="height:250px;" ShowArrows="true" ShowBullets="false" EnableSwipeGesture="false" AutoCycle="false" @bind-SelectedIndex="staticIndex">
    <ItemTemplate>
                    <div class="horizontal-scroll" style="height:100%; padding: 33px;">
    <MudText Typo="Typo.h4" Style="@($"color:{Colors.Purple.Darken3};")"> @context.First().StartDate.ToShortDateString() Day @(selectedIndex + 1) / @TripDays</MudText>
       
    <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Left" Reverse="false">

    @foreach (var attraction in @context)
        {
            <MudTimelineItem Color="Color.Transparent" Size="Size.Large">
                <ItemDot>
                    <MudText Style="@($"color:{Colors.Purple.Darken3};")" Typo="Typo.h4">@(context.IndexOf(attraction)+1)</MudText>
                </ItemDot>
                <ItemContent>
                 @if(attraction.Type == AttractionType.Attraction)
                {
                <MudIcon Icon="@Icons.Material.Filled.Museum" Size="Size.Large" Color="Color.Warning"/>
                }
                else if(attraction.Type == AttractionType.Accommodation)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Hotel" Size="Size.Large"  Color="Color.Secondary"/>
                }
                 else if(attraction.Type == AttractionType.Restaurant)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Fastfood" Size="Size.Large"  Color="Color.Tertiary"/>
                }
                       @(" "+attraction.Name)
                </ItemContent>
            </MudTimelineItem>
      
            <MudTimelineItem Color="Color.Info" Size="Size.Medium">
                <ItemContent>
            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info">Opening at:</MudChip>

               @if(attraction.Opening_Hours != "Opening hours are not available.")
                    {
                        <MudMenu MaxHeight="200"  FullWidth="true" ActivationEvent="@MouseEvent.MouseOver" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                             <ActivatorContent>
                         <MudChip T="string" Icon="@Icons.Material.Filled.AccessTime" Color="Color.Info">Working Time</MudChip>
                             </ActivatorContent>
                             <ChildContent>
                            @foreach(var i in attraction.Opening_Hours.Split(','))
                            {
                                 <MudMenuItem > @i </MudMenuItem>
                            }
                             </ChildContent>

                        </MudMenu>
                    }
                    else
                    {
                        @attraction.Opening_Hours
                    }

               </ItemContent>
            </MudTimelineItem>

            <MudTimelineItem Color="Color.Success" Size="Size.Medium">
                <ItemContent>
           <MudChip T="string" Variant="Variant.Outlined" Color="Color.Success">Address:</MudChip> @attraction.Vicinity
             </ItemContent>
            </MudTimelineItem>
            
            <MudTimelineItem Color="Color.Warning" Size="Size.Medium">
                <ItemContent>
            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Warning">Rating:</MudChip> @attraction.Rating
               </ItemContent>
            </MudTimelineItem>
             
            <MudTimelineItem Color="Color.Error" Size="Size.Medium">
                <ItemContent>
              <MudChip T="string" Variant="Variant.Outlined" Color="Color.Error">Website: </MudChip>
                    @if (attraction.Website != "Website is not available.")
                    {
                     <a target='_blank' jstcache='6' href='@attraction.Website' tabindex='0'> <span>Check the website!</span> </a> 
                    }
                    else
                    {
                     <a target='_blank' jstcache='6' href='@($"https://www.google.com/maps/place/?q=place_id:{@attraction.PlaceCode}")' tabindex='0'> <span>See on GoogleMaps</span> </a> 
                    }
                    
                    </ItemContent>
            </MudTimelineItem>
        }

        </MudTimeline>
        </div>

    </ItemTemplate>
    
    <PreviousButtonTemplate>
        <div @onclick="GoLeft" Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon">
            <span class="mud-icon-button-label">
                <MudIcon  Class="mud-ripple mud-ripple-icon mud-icon-button-size-medium" Icon="@Icons.Material.Filled.SkipPrevious" Color="@Color.Inherit" />
            </span>
        </div>
    </PreviousButtonTemplate>
    <NextButtonTemplate>
        <div @onclick="GoRight" Class="mud-button-root mud-icon-button mud-icon-button-color-inherit mud-ripple mud-ripple-icon">
            <span class="mud-icon-button-label">
                <MudIcon  Class="mud-ripple mud-ripple-icon mud-icon-button-size-medium" Icon="@Icons.Material.Filled.SkipNext" Color="@Color.Inherit" />
            </span>
        </div>
    </NextButtonTemplate>

</MudCarousel>
</MudItem>

<MudItem  xs="3">
    <MudPaper Outlined Class="border-dashed" Height="250px" >
        <MudText Align="Align.Center">Tags</MudText>
        <div style="height:200px; display: flex; flex-direction:column; overflow-y: auto; white-space: nowrap; gap: 8px; padding: 8px;">
        @foreach(var t in Tags)
        {
    <MudButton OnClick="()=>RemoveTag(t)"  EndIcon="@Icons.Material.Filled.Delete" Variant="Variant.Filled" Style="flex-shrink: 0; padding: 10px 20px;"><b>#@t.Name</b></MudButton>
        }
        </div>
    </MudPaper>

</MudItem>

</MudGrid>

<MudGrid>

    <MudItem xs="7" > 
<GoogleMap @ref="googleMapRef"
           ApiKey="@TravShell.App.GoogleAPI.GoogleService.apiKey"
           Center="@center"
           Height="280"
           Width="100"
           Zoom="12"
           Markers="markers" 
        Clickable="true"/>
    </MudItem>

           <MudItem xs="5" >

                        <MudExpansionPanels Style=" position: absolute; width:280px;">
                            <MudExpansionPanel  Text="New Tag">
                            <MudTextField T="string" @bind-Value="tagName" MaxLength="10" Label="Tag" Variant="Variant.Outlined" Counter="10" Immediate />
                            <MudButton  OnClick="SaveAndAddTag" Variant="Variant.Filled" Color="Color.Success">Save</MudButton>
                        </MudExpansionPanel>
                       <MudExpansionPanel  Text="Edit desc." MaxHeight="1000" >
                            <MudTextField T="string" @bind-Value="tripDescription" Disabled="@editMode" Immediate="true" Counter="1000" MaxLength="1000" Label="Description" Variant="Variant.Outlined" Lines="5" FullWidth />
                            <MudToolBar Class="gap-4">

                                <MudSwitch @bind-Value="editMode" Label="edit" Color="Color.Primary" />
                                <MudButton OnClick="SaveDescription" Disabled="@editMode" hidden="@editMode" Variant="Variant.Filled" Color="Color.Success">Save </MudButton>
                            </MudToolBar>
                   
                        </MudExpansionPanel>
                    </MudExpansionPanels>

                    <MudPaper style="margin-top:130px;" Outlined="true">
                            <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom>Description</MudText>
                        @if ((tripDescriptionMarkUp.Value.ToString()).Trim() == "")
                     {
                    <MudText Label="Description" Align="Align.Center" Style="max-height: 10em; overflow-y: auto;">
                                No description. :(

                            </MudText>
                     }
                     else
                     {
	                <MudText Label="Description" Align="Align.Center" Style="max-height: 10em; overflow-y: auto; word-break: break-word;">
                            @(tripDescriptionMarkUp)

                    </MudText>
                     }
                    </MudPaper>

           </MudItem>
            </MudGrid>  
        </MudContainer>
    }
    else
    {
        <h1>Trip @TripId does not exist.</h1>
    }
    }
}
else
{
    <h1>Not Authorized</h1>
}

@code {

    [Inject]
    public required IAttractionService attractionsService { get; set; }

    [Inject]
    public required ITripService tripsService { get; set; }

    [Inject]
    public required ITagService tagsService { get; set; }

    [Parameter]
    public int UserId { get; set; }
    [Parameter]
    public int TripId { get; set; }

    public List<Attraction> Attractions { get; set; } = default;

    public Dictionary<DateTime, List<Attraction>> AttractionMap { get; set; } = new();

    public int TripDays { get; set; }

    GoogleMap googleMapRef = default!;

    public GoogleMapCenter center /*= new GoogleMapCenter(37.50024109655184, -122.28528451834352)*/;
    public List<GoogleMapMarker> markers = new();

    public List<List<GoogleMapMarker>> AllMarkers = new();

    public Trip currentTrip { get; set; }
    public string TripName { get; set; } = "Loading...";

    private MudCarousel<List<Attraction>> _carousel;
    private IList<List<Attraction>> _source = new List<List<Attraction>>();

    private int staticIndex = 0;

    private int selectedIndex = 0;

    private bool IsAuth = false;

    private bool TripExists = true;

    private bool editMode = true;

    private string tripDescription = "";

    private MarkupString? tripDescriptionMarkUp = (MarkupString)"";

    MarkdownPipeline pipeline = default;

    private bool isPublic = false;

    private string tagName="";

    private List<Tag> Tags = new List<Tag>();

    private bool IsPublishProcess = false;

    private bool IsTripComplete = false;


    protected async override Task OnInitializedAsync()//zmniejszyć to!!!
    {
        var authState = await ASP.GetAuthenticationStateAsync();

        if (authState.User.Identity.IsAuthenticated)
        {
            currentTrip = await tripsService.FindTripById(TripId);

            if(currentTrip ==null)
            {
                TripExists = false;
                return;
            }
            int userIdCheck = Int32.Parse(authState.User.Identity.Name);
            if(userIdCheck == currentTrip.User.UserId)
            {
                IsAuth = true;

                pipeline = new MarkdownPipelineBuilder()
                .UseAdvancedExtensions() 
                .DisableHtml()
                    .UseEmojiAndSmiley()
                   .Build();

                if(currentTrip.Description !=null)
                {
                    tripDescription = currentTrip.Description;
                    isPublic = currentTrip.IsPublic;
                    tripDescriptionMarkUp =(MarkupString) Markdig.Markdown.ToHtml(tripDescription, pipeline);
                    StateHasChanged();
                }

                if(currentTrip == null)
                {
                    TripExists = false;
                    return;
                }

                TripName = currentTrip.Name;
                int numOfAtt = await attractionsService.CountTripAttractions(TripId);
                if (numOfAtt == 0)
                {
                    return;
                }
                IsTripComplete = true;
                Attractions = await attractionsService.GetTripAttractionsOrderByStartDate(TripId);

                DateTime tmp = Attractions.First().StartDate;

                List<Attraction> tmpList = new();
                foreach(var a in Attractions)
                {
                    if (a.StartDate == tmp )
                    {
                        tmpList.Add(a);
                    }
                    else
                    {
                        AttractionMap.Add(tmp, tmpList);

                        tmp=a.StartDate;

                        tmpList = new();

                        tmpList.Add(a);

                        if(Attractions.Last()==a)
                        {
                            AttractionMap.Add(tmp, tmpList);
                            break;
                        }
                    }
                    if (Attractions.Last() == a)
                    {
                        AttractionMap.Add(tmp, tmpList);
                    }
                }

                foreach (var a in AttractionMap)
                {
                    _source.Add(a.Value.OrderBy(x=>x.step).ToList());
                }

                int i = 1;
                foreach(var a in AttractionMap)
                {
                    i = 1;

                    var newMarkers = new List<GoogleMapMarker>();

                    foreach(var aa in a.Value.OrderBy(x=>x.step).ToList())
                    {
                        newMarkers.Add(new GoogleMapMarker()
                        {
                            Position = new GoogleMapMarkerPosition(aa.latitude, aa.longitude),

                            PinElement = new PinElement
                            {
                                Glyph = (i++) + "",
                                GlyphColor = "white",
                                Background = "Purple",
                                BorderColor="Black"

                            },

                            Title = aa.Website != "Website is not available." ? $" <a target = '_blank' jstcache = '6' href = '{aa.Website}' tabindex = '0'> <span> Check the website!</span> </a> " : "<h1> No Website available </h1>",
                        });
                    }
                    AllMarkers.Add(newMarkers);
                }
                markers = AllMarkers[0];

                var trip = await tripsService.FindTripById(TripId);

                if(trip != null)
                {
                    TripDays = trip.Days;
                    center = new GoogleMapCenter(trip.latitude, trip.longitude);
                }
                await GetAllTripTags();

                StateHasChanged();
                await Task.Delay(3);
                await googleMapRef.RefreshAsync();
            }
        }
    }

    private bool editDescription()
    {
        editMode=false;
        StateHasChanged();

        return editMode;
    }

    private async void SaveDescription()
    {
        await tripsService.EditTripDescription(tripDescription.ToString(), TripId);
        editMode = true;

        UpdateHTMLAsync();
        StateHasChanged();

        Snackbar.Add($"Description has been saved!", Severity.Success);
    }

    private async void RefreshMap()
    {
        await googleMapRef.RefreshAsync();
        await googleMapRef.UpdateMarkersAsync(markers);
    }

    private async Task GoLeft()
    {
        selectedIndex--;
        if(selectedIndex<0)
        {
            markers = AllMarkers.Last();
            selectedIndex = TripDays - 1;
        }
        else
        {
            markers = AllMarkers[selectedIndex];
        }

        await googleMapRef.UpdateMarkersAsync(markers);
        await InvokeAsync(StateHasChanged);
    }

    private async Task GoRight()
    {
        selectedIndex++;
        if (selectedIndex >= TripDays)
        {
            selectedIndex = 0;

            markers = AllMarkers.First();
        }
        else
        {
            markers = AllMarkers[selectedIndex];
        }
        await googleMapRef.UpdateMarkersAsync(markers);
        await InvokeAsync(StateHasChanged);
    }


    protected void UpdateHTMLAsync()
    {
        if (currentTrip.Description != null)
        {
            tripDescriptionMarkUp = (MarkupString)Markdig.Markdown.ToHtml(currentTrip.Description, pipeline);
        }
    }

    private async Task ChangeVisbility(bool publicModifier)
    {
        IsPublishProcess = true;
        StateHasChanged();

        await tripsService.ChangeTripVisibility(publicModifier, TripId);

        isPublic = publicModifier;
        IsPublishProcess = false;
        StateHasChanged();
    }

    private async void SaveAndAddTag()
    {
        if (tagName.Trim() == "") return;
        var t = await tagsService.CreateTag(UserId, tagName);

        if(t != null)
        {
            await tagsService.AttachTagToTrip(TripId, t);

            tagName="";
            await GetAllTripTags();
        }
    }

    private async Task GetAllTripTags()
    {
        var tags =  await tagsService.GetTripTags(TripId);
        if(tags != null)
        {
            Tags = tags;
            StateHasChanged();
        }
    }

    private async void RemoveTag(Tag t)
    {
        if(t !=null)
        {
            await tagsService.RemoveTagFromTrip(TripId, t);
            await  GetAllTripTags();
        }
    }

    private bool CheckTripCompleteness()
    {
        for(var i = 0; i < currentTrip.Days; i++)
        {
            Console.WriteLine(currentTrip.Firstdate.AddDays(i) + " last date "+ currentTrip.Lastdate);
            if(Attractions.Where(x => x.StartDate == currentTrip.Firstdate.AddDays(i)).Count()<=0)
            {
                return false;
            }
        }
        return true;
    }
}
