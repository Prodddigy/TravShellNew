        white-space: nowrap;
        overflow-x: auto; 
        width: 100%; 
        border: 1px solid #ccc; 
        padding: 10px; 
        position: relative;
        height:80vh; 
    }
    .horizontal-scroll span {
        display: inline-block;
        top:0px;
    }
