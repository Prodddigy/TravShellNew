@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager navigationManager
@inject AuthenticationStateProvider ASP


<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.House">Home</MudNavLink>

<CascadingAuthenticationState>
	<AuthorizeView>
	<Authorized>
    <MudNavLink OnClick="EnterCreateTrip" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Create">Create trip</MudNavLink>
    <MudNavLink OnClick="EnterTrips" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.GridOn">Your trips</MudNavLink>
    <MudNavLink OnClick="EnterPublicTrips" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Public"> Public trips </MudNavLink>

    <MudNavLink Href="/logout" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Logout">Logout</MudNavLink>

            </Authorized>

            <NotAuthorized>
                <MudNavLink Href="/login" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Login">Login</MudNavLink>
                <MudNavLink Href="/register" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountCircle">Register</MudNavLink>
            </NotAuthorized>
        </AuthorizeView>
    </CascadingAuthenticationState>

</MudNavMenu>


@code{
    private async void EnterTrips()
    {
        var authState = await ASP.GetAuthenticationStateAsync();

        if (authState.User.Identity.IsAuthenticated)
        {
            navigationManager.NavigateTo($"/trips/{Int32.Parse(authState.User.Identity.Name)}");
        }
    }

    private async void EnterCreateTrip()
    {
        var authState = await ASP.GetAuthenticationStateAsync();
        if (authState.User.Identity.IsAuthenticated)
        {
            navigationManager.NavigateTo($"/createTrip/{Int32.Parse(authState.User.Identity.Name)}/newTrip");
        }
    }

    private async void EnterPublicTrips()
    {
        var authState = await ASP.GetAuthenticationStateAsync();
        if(authState.User.Identity.IsAuthenticated)
        {
            navigationManager.NavigateTo($"/public-trips/{Int32.Parse(authState.User.Identity.Name)}");
        }
    }
}
