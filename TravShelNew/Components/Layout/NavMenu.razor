@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager navigationManager
@inject AuthenticationStateProvider ASP


<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.OtherHouses">Home</MudNavLink>


    
<CascadingAuthenticationState>
	<AuthorizeView>
	<Authorized>

    <MudNavLink OnClick="EnterTrips" Match="NavLinkMatch.Prefix">Trips</MudNavLink>

    <MudNavLink Href="/logout"  Match="NavLinkMatch.Prefix">Logout</MudNavLink>

            </Authorized>

            <NotAuthorized>
                <MudNavLink Href="/login" Match="NavLinkMatch.Prefix">Login</MudNavLink>
                <MudNavLink Href="/register" Match="NavLinkMatch.Prefix">Register</MudNavLink>
            </NotAuthorized>
        </AuthorizeView>
    </CascadingAuthenticationState>


</MudNavMenu>


@code{


    private async void EnterTrips()
    {

        var authState = await ASP.GetAuthenticationStateAsync();


        if (authState.User.Identity.IsAuthenticated)
        {

            //   UserId = Int32.Parse(authState.User.Identity.Name);



                navigationManager.NavigateTo($"/trips/{Int32.Parse(authState.User.Identity.Name)}");
            }
    }
}
